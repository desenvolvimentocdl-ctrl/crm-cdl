@model bool
@{
    ViewData["Title"] = "Importar da Kommo";
    var r = TempData["kommo"] is string json ? System.Text.Json.JsonSerializer.Deserialize<CrmCDL.Application.ResultadoImportacao>(json) : null;
}
@await Html.PartialAsync("_Abas", "kommo")
<div class="pagina pilha" style="max-width:720px">
    <div class="card card-pad pilha">
        <h2>Estrutura da Kommo</h2>
        <p class="muted" style="margin:0">Traz <b>funis, etapas, campos personalizados, motivos de perda e tags</b> da conta da Kommo. Só lê a Kommo, não altera nada lá.
            Pode rodar de novo quando quiser: o que já foi importado é atualizado, sem duplicar. Funis cujo nome começa com "Teste" ficam de fora.</p>
        @if (!Model)
        {
            <div class="alerta-erro">Integração não configurada. Defina <code>Kommo__BaseUrl</code> e <code>Kommo__Token</code> no servidor.</div>
        }
        else
        {
            <form method="post" asp-antiforgery="true" action="/configuracoes/kommo" onsubmit="this.querySelector('button').disabled=true;this.querySelector('button').textContent='Importando…'"><button class="btn pri">Importar estrutura agora</button></form>
        }
    </div>
    @if (r is not null)
    {
        <div class="card card-pad pilha">
            <h2>Importação concluída</h2>
            <div class="kpis" style="margin:0">
                <div class="kpi"><div class="l">Funis</div><div class="v">@r.Funis</div></div>
                <div class="kpi"><div class="l">Etapas</div><div class="v">@r.Etapas</div></div>
                <div class="kpi"><div class="l">Campos</div><div class="v">@r.Campos</div><div class="s">@r.Opcoes opções</div></div>
                <div class="kpi"><div class="l">Motivos de perda</div><div class="v">@r.MotivosPerda</div></div>
                <div class="kpi"><div class="l">Tags</div><div class="v">@r.Tags</div></div>
            </div>
            @if (r.Avisos.Count > 0)
            {
                <h3>Observações</h3>
                <ul style="margin:0;padding-left:18px">@foreach (var a in r.Avisos) { <li>@a</li> }</ul>
            }
        </div>
    }
</div>
