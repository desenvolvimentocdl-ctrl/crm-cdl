@model List<Lead>
<section class="secao">
    <h3>Leads (@Model.Count)</h3>
    @if (Model.Count == 0) { <p class="muted" style="margin:0">Nenhum lead vinculado.</p> }
    @foreach (var l in Model)
    {
        <div class="vinculo">
            <span class="ponto" style="background:@l.Etapa!.Cor"></span>
            <div class="info"><b><a href="/leads/@l.Id" style="color:inherit">@l.Titulo</a></b><small>@l.Funil!.Nome · @l.Etapa.Nome</small></div>
            <span class="num muted">@Hora.Dinheiro(l.Valor)</span>
        </div>
    }
</section>
