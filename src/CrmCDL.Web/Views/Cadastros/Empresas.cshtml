@model List<CrmCDL.Web.Controllers.CadastrosController.EmpresaLinha>
@{
    ViewData["Title"] = "Empresas";
    int total = ViewBag.Total, pagina = ViewBag.Pagina, porPagina = ViewBag.PorPagina;
}
<header class="topo">
    <h1>Empresas <span class="pill cinza num">@total</span></h1>
    <form method="get" class="busca"><svg><use href="#i-busca"/></svg><input type="search" name="busca" value="@ViewBag.Busca" placeholder="Nome, CNPJ, e-mail…" aria-label="Buscar empresas"></form>
    <button class="btn pri" data-abre="#nova"><svg><use href="#i-mais"/></svg>Nova empresa</button>
</header>
<div class="pagina">
    <div class="card" style="overflow:hidden">
        @if (Model.Count == 0) { <div class="vazio">Nenhuma empresa encontrada.</div> }
        else
        {
            <table class="tabela">
                <thead><tr><th>Empresa</th><th>CNPJ</th><th class="ocultar-cel">Telefone</th><th class="ocultar-cel">Contatos</th><th class="ocultar-cel">Leads</th></tr></thead>
                <tbody>
                @foreach (var e in Model)
                {
                    <tr data-href="/empresas/@e.Id">
                        <td><a class="nome" href="/empresas/@e.Id"><span class="av sm" style="border-radius:6px;background:var(--navy-2)">@Texto.Iniciais(e.Nome)</span>@e.Nome</a></td>
                        <td class="num">@e.Cnpj</td>
                        <td class="ocultar-cel">@e.Telefone</td>
                        <td class="ocultar-cel num">@e.Contatos</td>
                        <td class="ocultar-cel num">@e.Leads</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
    @await Html.PartialAsync("_Paginacao", (pagina, (int)Math.Ceiling(total / (double)porPagina), (string?)ViewBag.Busca))
</div>
<dialog id="nova">
    <form method="post" asp-antiforgery="true" action="/empresas/nova">
        <div class="modal-cab"><h2>Nova empresa</h2><button type="button" class="ico-btn" data-fecha aria-label="Fechar"><svg><use href="#i-x"/></svg></button></div>
        <div class="modal-corpo">
            <label class="campo">Nome *<input name="nome" required></label>
            <label class="campo">CNPJ<input name="cnpj"></label>
        </div>
        <div class="modal-pe"><button type="button" class="btn" data-fecha>Cancelar</button><button class="btn pri">Criar</button></div>
    </form>
</dialog>
