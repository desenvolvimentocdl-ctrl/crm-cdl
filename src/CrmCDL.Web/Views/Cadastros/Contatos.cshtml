@model List<Contato>
@{
    ViewData["Title"] = "Contatos";
    int total = ViewBag.Total, pagina = ViewBag.Pagina, porPagina = ViewBag.PorPagina;
    var paginas = (int)Math.Ceiling(total / (double)porPagina);
}
<header class="topo">
    <h1>Contatos <span class="pill cinza num">@total</span></h1>
    <form method="get" class="busca"><svg><use href="#i-busca"/></svg><input type="search" name="busca" value="@ViewBag.Busca" placeholder="Nome, telefone, e-mail, CPF…" aria-label="Buscar contatos"></form>
    <button class="btn pri" data-abre="#novo"><svg><use href="#i-mais"/></svg>Novo contato</button>
</header>
<div class="pagina">
    <div class="card" style="overflow:hidden">
        @if (Model.Count == 0) { <div class="vazio">Nenhum contato encontrado.</div> }
        else
        {
            <table class="tabela">
                <thead><tr><th>Nome</th><th>Celular</th><th class="ocultar-cel">E-mail</th><th class="ocultar-cel">Empresa</th><th class="ocultar-cel">Responsável</th></tr></thead>
                <tbody>
                @foreach (var c in Model)
                {
                    <tr data-href="/contatos/@c.Id">
                        <td><a class="nome" href="/contatos/@c.Id"><span class="av sm">@Texto.Iniciais(c.Nome)</span>@c.Nome</a>@if (c.Cargo is not null) { <small class="muted">@c.Cargo</small> }</td>
                        <td class="num">@c.Celular</td>
                        <td class="ocultar-cel">@c.Email</td>
                        <td class="ocultar-cel">@c.Empresa?.Nome</td>
                        <td class="ocultar-cel">@c.Responsavel?.Nome</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
    @await Html.PartialAsync("_Paginacao", (pagina, paginas, (string?)ViewBag.Busca))
</div>
<dialog id="novo">
    <form method="post" asp-antiforgery="true" action="/contatos/novo">
        <div class="modal-cab"><h2>Novo contato</h2><button type="button" class="ico-btn" data-fecha aria-label="Fechar"><svg><use href="#i-x"/></svg></button></div>
        <div class="modal-corpo">
            <label class="campo">Nome *<input name="nome" required></label>
            <div class="grid2"><label class="campo">Celular / WhatsApp<input name="celular"></label><label class="campo">E-mail<input name="email" type="email"></label></div>
            <label class="campo">Empresa<input name="empresa"></label>
        </div>
        <div class="modal-pe"><button type="button" class="btn" data-fecha>Cancelar</button><button class="btn pri">Criar</button></div>
    </form>
</dialog>
