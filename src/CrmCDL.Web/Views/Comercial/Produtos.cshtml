@model List<Produto>
@{ ViewData["Title"] = "Produtos"; }
@await Html.PartialAsync("~/Views/Configuracoes/_Abas.cshtml", "produtos")
<div class="pagina pilha" style="max-width:1000px">
    <p class="muted" style="margin:0">Catálogo do que a CDL vende. Na página do lead, os produtos escolhidos somam o valor da venda.</p>
    <form method="post" asp-antiforgery="true" action="/configuracoes/produtos" class="card card-pad">
        <h2 style="margin-bottom:12px">Novo produto ou serviço</h2>
        <div class="linha" style="align-items:end">
            <label class="campo" style="flex:2 1 200px">Nome<input name="nome" required placeholder="Ex.: Associação anual – Plano Empresa"></label>
            <label class="campo" style="flex:1 1 140px">Categoria<input name="categoria" list="categorias" placeholder="Associação, Cursos…"></label>
            <label class="campo" style="flex:1 1 110px">Preço (R$)<input name="preco" type="number" min="0" step="0.01" required></label>
            <button class="btn pri"><svg><use href="#i-mais"/></svg>Adicionar</button>
        </div>
        <datalist id="categorias">@foreach (var c in Model.Select(p => p.Categoria).Where(c => c != null).Distinct()) { <option value="@c"></option> }</datalist>
    </form>
    <div class="card rolavel" style="overflow:hidden">
        <table class="tabela">
            <thead><tr><th>Produto</th><th>Categoria</th><th>Preço</th><th>Ativo</th><th></th></tr></thead>
            <tbody>
            @if (Model.Count == 0) { <tr><td colspan="5" class="vazio">Nenhum produto cadastrado.</td></tr> }
            @foreach (var p in Model)
            {
                <tr style="@(p.Ativo ? "" : "opacity:.55")">
                    <td><form id="p@(p.Id)" method="post" asp-antiforgery="true" action="/configuracoes/produtos"><input type="hidden" name="id" value="@p.Id"></form>
                        <input form="p@(p.Id)" name="nome" value="@p.Nome" required></td>
                    <td><input form="p@(p.Id)" name="categoria" value="@p.Categoria" list="categorias"></td>
                    <td><input form="p@(p.Id)" name="preco" type="number" min="0" step="0.01" value="@p.Preco.ToString(System.Globalization.CultureInfo.InvariantCulture)" style="width:120px"></td>
                    <td><input form="p@(p.Id)" type="checkbox" name="ativo" value="true" checked="@p.Ativo" aria-label="Ativo"><input form="p@(p.Id)" type="hidden" name="ativo" value="false"></td>
                    <td><button form="p@(p.Id)" class="btn sm">Salvar</button></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
